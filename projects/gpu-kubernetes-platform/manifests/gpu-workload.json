{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "gpu-reference-workload",
    "namespace": "ai-platform"
  },
  "spec": {
    "restartPolicy": "Never",
    "nodeSelector": {
      "workload-class": "gpu"
    },
    "tolerations": [
      {
        "key": "workload-class",
        "operator": "Equal",
        "value": "gpu",
        "effect": "NoSchedule"
      }
    ],
    "containers": [
      {
        "name": "reference-workload",
        "image": "REPLACE_WITH_APPROVED_IMAGE",
        "resources": {
          "requests": {
            "cpu": "4",
            "memory": "16Gi",
            "nvidia.com/gpu": "1"
          },
          "limits": {
            "cpu": "8",
            "memory": "32Gi",
            "nvidia.com/gpu": "1"
          }
        }
      }
    ]
  }
}
