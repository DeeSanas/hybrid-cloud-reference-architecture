{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {"name": "platform-prod", "labels": {"environment": "production"}}
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {"name": "platform-prod-quota", "namespace": "platform-prod"},
      "spec": {
        "hard": {
          "requests.cpu": "20",
          "requests.memory": "64Gi",
          "limits.cpu": "40",
          "limits.memory": "128Gi"
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {"name": "default-deny-all", "namespace": "platform-prod"},
      "spec": {
        "podSelector": {},
        "policyTypes": ["Ingress", "Egress"]
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {"name": "critical-workload-pdb", "namespace": "platform-prod"},
      "spec": {
        "minAvailable": 2,
        "selector": {"matchLabels": {"app.kubernetes.io/tier": "critical"}}
      }
    }
  ]
}
